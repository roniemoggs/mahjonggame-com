---
import { languages, type ui } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath, getRouteFromUrl } from '../i18n/utils';
import { Globe } from 'lucide-react';

interface Props {
  className?: string;
  variant?: 'compact' | 'full';
}

const { className = '', variant = 'compact' } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const route = getRouteFromUrl(Astro.url) || '';
---

<div class={`inline-flex items-center gap-1.5 ${className}`}>
  {variant === 'full' ? (
    <div class="flex items-center gap-1.5 p-1 rounded-xl bg-slate-900/90 border border-slate-800 text-xs shadow-inner">
      <div class="px-2 py-1 text-slate-400 flex items-center gap-1.5">
        <Globe className="w-3.5 h-3.5 text-emerald-400" />
        <span class="font-medium">Language</span>
      </div>
      <div class="flex items-center gap-1">
        {Object.entries(languages).map(([langKey, label]) => {
          const lang = langKey as keyof typeof ui;
          const translatePath = useTranslatedPath(lang);
          const targetPath = translatePath(route ? `/${route}` : '/');
          const isActive = currentLang === lang;

          return (
            <a
              href={targetPath}
              class={`px-2.5 py-1 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 ${
                isActive
                  ? 'bg-emerald-600 text-white shadow-sm'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800'
              }`}
              aria-current={isActive ? 'page' : undefined}
              title={`Switch to ${label}`}
            >
              <span>{langKey === 'ja' ? '🇯🇵' : '🇺🇸'}</span>
              <span>{label}</span>
            </a>
          );
        })}
      </div>
    </div>
  ) : (
    <div class="relative inline-flex items-center rounded-xl bg-slate-900/80 border border-slate-800 p-1 text-xs">
      <Globe className="w-3.5 h-3.5 text-emerald-400 ml-1.5 mr-1" />
      <div class="flex items-center">
        {Object.entries(languages).map(([langKey, label]) => {
          const lang = langKey as keyof typeof ui;
          const translatePath = useTranslatedPath(lang);
          const targetPath = translatePath(route ? `/${route}` : '/');
          const isActive = currentLang === lang;

          return (
            <a
              href={targetPath}
              class={`px-2 py-1 rounded-lg text-[11px] font-bold tracking-wide uppercase transition-all ${
                isActive
                  ? 'bg-emerald-600 text-white shadow-sm'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/80'
              }`}
              aria-current={isActive ? 'page' : undefined}
              title={`Switch to ${label}`}
            >
              {langKey}
            </a>
          );
        })}
      </div>
    </div>
  )}
</div>
