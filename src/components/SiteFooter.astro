---
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  lang?: 'ja' | 'en';
}

const { lang: propLang } = Astro.props;
const currentLang = propLang || getLangFromUrl(Astro.url);
const isEn = currentLang === 'en';

const homeUrl = isEn ? '/en/' : '/';
const yakuUrl = isEn ? '/en/yaku' : '/yaku';
const calculatorUrl = isEn ? '/en/calculator' : '/calculator';
const rulesUrl = isEn ? '/en/#rules' : '/#rules';
---

<footer class="border-t border-slate-800/80 bg-slate-950 py-12 text-center text-xs text-slate-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-slate-800/60 pb-6">
      <div class="flex items-center gap-2 font-bold text-slate-300 text-sm">
        <span>🀄 {isEn ? 'Mahjong Web' : '麻雀web'}</span>
        <span>•</span>
        <span>{isEn ? 'mahjong-game.com' : '麻雀ゲーム.com'}</span>
      </div>

      <nav class="flex items-center gap-6 text-xs text-slate-400">
        <a href={homeUrl} class="hover:text-emerald-400 transition-colors">
          {isEn ? 'Play Online' : 'オンライン対局'}
        </a>
        <a href={yakuUrl} class="hover:text-emerald-400 transition-colors">
          {isEn ? 'Yaku Guide' : '役一覧ガイド'}
        </a>
        <a href={calculatorUrl} class="hover:text-emerald-400 transition-colors">
          {isEn ? 'Score Calculator' : '点数計算シミュレーター'}
        </a>
        <a href={rulesUrl} class="hover:text-emerald-400 transition-colors">
          {isEn ? 'Rule Settings' : 'ルール設定'}
        </a>
      </nav>

      <LanguagePicker variant="full" />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left text-xs">
      <div class="space-y-2">
        <div class="font-bold text-slate-300">
          {isEn ? 'About Mahjong Web' : '麻雀web について'}
        </div>
        <p class="text-slate-400 leading-relaxed">
          {isEn
            ? 'Play authentic Japanese Riichi Mahjong online in your browser for free with no registration required. Powered by modern AI engines and crisp vector SVG tile rendering.'
            : '登録不要・完全無料で遊べるブラウザ麻雀ゲーム。電脳麻将エンジン（@kobalab/majiang-core）による本格AI対戦と、SVGベクター牌描画を提供します。'}
        </p>
      </div>
      <div class="space-y-2">
        <div class="font-bold text-slate-300">
          {isEn ? 'Learning & Tools' : '学習・ツール'}
        </div>
        <ul class="space-y-1 text-slate-400">
          <li>
            <a href={yakuUrl} class="hover:text-emerald-400 transition-colors">
              {isEn ? '• All 38 Yaku Guide (1 Han to Yakuman hands)' : '・麻雀役一覧（1翻〜役満・全手牌サンプル付き）'}
            </a>
          </li>
          <li>
            <a href={calculatorUrl} class="hover:text-emerald-400 transition-colors">
              {isEn ? '• Score Calculator (Real-time Fu, Han & Payment)' : '・点数計算シミュレーター（符・翻・点数授受詳細）'}
            </a>
          </li>
          <li>
            <a href={calculatorUrl} class="hover:text-emerald-400 transition-colors">
              {isEn ? '• Scoring Practice Drills (Master Fu calculation with quiz)' : '・点数計算練習ドリル（クイズ形式で実戦力アップ）'}
            </a>
          </li>
        </ul>
      </div>
      <div class="space-y-2">
        <div class="font-bold text-slate-300">
          {isEn ? 'Supported Rules' : '対応ルール'}
        </div>
        <p class="text-slate-400 leading-relaxed">
          {isEn
            ? 'Standard Japanese Riichi Mahjong rules (25,000 start / 30,000 return, open Tanyao enabled, 3 Red Dora, formal tenpai, Kiriage Mangan allowed).'
            : '日本プロ麻雀連盟 / 天鳳互換ルール（25,000点持ち/30,000点返し、喰いタンあり、赤ドラ3枚、形式テンパイあり、切り上げ満貫あり）。'}
        </p>
      </div>
    </div>

    <div class="text-slate-600 border-t border-slate-900 pt-6">
      © 2026 {isEn ? 'mahjong-game.com' : '麻雀ゲーム.com'} All Rights Reserved.
    </div>
  </div>
</footer>

