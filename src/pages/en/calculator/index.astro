---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ScoreCalculator from '../../../components/calculator/ScoreCalculator';
import { Sparkles, ChevronRight, Table } from 'lucide-react';
---

<Layout
  lang="en"
  title="Riichi Mahjong Score Calculator & Fu Practice Drills | Mahjong Web"
  description="Instant Riichi Mahjong score calculation simulator. Select 14 hand tiles, win conditions (Tsumo/Ron, winds, Riichi, Dora) to calculate Fu, Han, Yaku, and player payments. Includes interactive practice drills."
>
  <!-- Top Navigation -->
  <SiteHeader activeNav="calculator" lang="en" />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400">
      <a href="/en/" class="hover:text-emerald-400 transition-colors">Home</a>
      <ChevronRight className="w-3.5 h-3.5 text-slate-600" />
      <span class="text-slate-200 font-semibold">Score Calculator & Practice Drills</span>
    </nav>

    <!-- Hero Header -->
    <section class="space-y-4 text-center max-w-3xl mx-auto pt-2">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 text-xs font-semibold">
        <Sparkles className="w-3.5 h-3.5 text-cyan-400 animate-spin" />
        Fully Compliant with Official Japanese Riichi Engine (@kobalab/majiang-core)
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white font-['Outfit',sans-serif] leading-tight">
        Riichi Mahjong Score Calculator
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        Select 14 tiles, winning tile, Tsumo/Ron, and seat/prevalent winds to calculate Fu, Han, Yaku, and score transfers in real-time.<br class="hidden sm:inline" />
        Master tricky Fu calculations quickly using the interactive scoring practice quiz drills.
      </p>
    </section>

    <!-- Interactive Calculator & Practice Component -->
    <section class="space-y-6">
      <ScoreCalculator client:load lang="en" />
    </section>

    <!-- Reference Section: Fu & Score Lookup Guide (SEO & Educational Reference) -->
    <section class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-8">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
          <Table className="w-5 h-5 text-cyan-400" />
          Japanese Riichi Mahjong Scoring Matrix & Fu Reference Table
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Quick lookup table for common Fu and Han combinations (Dealer, Non-Dealer, Ron, and Tsumo).
        </p>
      </div>

      <!-- Score Matrix Grid -->
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left border-collapse border border-slate-800 rounded-xl overflow-hidden">
          <thead>
            <tr class="bg-slate-950 text-slate-300 border-b border-slate-800">
              <th class="p-3 font-bold border-r border-slate-800">Fu / Han</th>
              <th class="p-3 font-bold border-r border-slate-800">1 Han</th>
              <th class="p-3 font-bold border-r border-slate-800">2 Han</th>
              <th class="p-3 font-bold border-r border-slate-800">3 Han</th>
              <th class="p-3 font-bold">4 Han</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-mono">
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-3 font-sans font-bold text-emerald-400 bg-slate-950/60 border-r border-slate-800">
                20 Fu (Pinfu Tsumo)
              </td>
              <td class="p-3 text-slate-500 border-r border-slate-800">-</td>
              <td class="p-3 text-white border-r border-slate-800">Non-dealer 400/700 • Dealer 700 all</td>
              <td class="p-3 text-white border-r border-slate-800">Non-dealer 700/1300 • Dealer 1300 all</td>
              <td class="p-3 text-white">Non-dealer 1300/2600 • Dealer 2600 all</td>
            </tr>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-3 font-sans font-bold text-cyan-400 bg-slate-950/60 border-r border-slate-800">
                25 Fu (Seven Pairs)
              </td>
              <td class="p-3 text-slate-500 border-r border-slate-800">-</td>
              <td class="p-3 text-white border-r border-slate-800">Non-dealer 1,600 • Dealer 2,400</td>
              <td class="p-3 text-white border-r border-slate-800">Non-dealer 3,200 • Dealer 4,800</td>
              <td class="p-3 text-white">Non-dealer 6,400 • Dealer 9,600</td>
            </tr>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-3 font-sans font-bold text-slate-200 bg-slate-950/60 border-r border-slate-800">
                30 Fu (Standard Hand)
              </td>
              <td class="p-3 text-white border-r border-slate-800">1,000 (300/500) • Dealer 1,500 (500 all)</td>
              <td class="p-3 text-white border-r border-slate-800">2,000 (500/1,000) • Dealer 2,900 (1,000 all)</td>
              <td class="p-3 text-white border-r border-slate-800">3,900 (1,000/2,000) • Dealer 5,800 (2,000 all)</td>
              <td class="p-3 text-white">7,700 (2,000/3,900) • Dealer 11,600 (3,900 all)</td>
            </tr>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-3 font-sans font-bold text-slate-200 bg-slate-950/60 border-r border-slate-800">
                40 Fu (Concealed Ron)
              </td>
              <td class="p-3 text-white border-r border-slate-800">1,300 (400/700) • Dealer 2,000 (700 all)</td>
              <td class="p-3 text-white border-r border-slate-800">2,600 (700/1,300) • Dealer 3,900 (1,300 all)</td>
              <td class="p-3 text-white border-r border-slate-800">5,200 (1,300/2,600) • Dealer 7,700 (2,600 all)</td>
              <td class="p-3 text-amber-300 font-bold">Mangan (8,000 / 12,000)</td>
            </tr>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-3 font-sans font-bold text-slate-200 bg-slate-950/60 border-r border-slate-800">
                50 Fu (Honor/Terminal Triplet)
              </td>
              <td class="p-3 text-white border-r border-slate-800">1,600 (400/800) • Dealer 2,400 (800 all)</td>
              <td class="p-3 text-white border-r border-slate-800">3,200 (800/1,600) • Dealer 4,800 (1,600 all)</td>
              <td class="p-3 text-white border-r border-slate-800">6,400 (1,600/3,200) • Dealer 9,600 (3,200 all)</td>
              <td class="p-3 text-amber-300 font-bold">Mangan (8,000 / 12,000)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- High Hand Caps Summary -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-center">
        <div class="bg-slate-950/80 border border-emerald-500/30 p-3 rounded-xl space-y-0.5">
          <div class="text-[11px] text-emerald-400 font-bold">Mangan (5 Han)</div>
          <div class="text-sm font-black text-white font-mono">8,000 / 12,000</div>
          <div class="text-[10px] text-slate-400">Tsumo: 2000/4000 (4000 all)</div>
        </div>
        <div class="bg-slate-950/80 border border-cyan-500/30 p-3 rounded-xl space-y-0.5">
          <div class="text-[11px] text-cyan-400 font-bold">Haneman (6-7 Han)</div>
          <div class="text-sm font-black text-white font-mono">12,000 / 18,000</div>
          <div class="text-[10px] text-slate-400">Tsumo: 3000/6000 (6000 all)</div>
        </div>
        <div class="bg-slate-950/80 border border-purple-500/30 p-3 rounded-xl space-y-0.5">
          <div class="text-[11px] text-purple-400 font-bold">Baiman (8-10 Han)</div>
          <div class="text-sm font-black text-white font-mono">16,000 / 24,000</div>
          <div class="text-[10px] text-slate-400">Tsumo: 4000/8000 (8000 all)</div>
        </div>
        <div class="bg-slate-950/80 border border-rose-500/30 p-3 rounded-xl space-y-0.5">
          <div class="text-[11px] text-rose-400 font-bold">Sanbaiman (11-12 Han)</div>
          <div class="text-sm font-black text-white font-mono">24,000 / 36,000</div>
          <div class="text-[10px] text-slate-400">Tsumo: 6000/12000 (12000 all)</div>
        </div>
        <div class="bg-slate-950/80 border border-amber-500/30 p-3 rounded-xl space-y-0.5">
          <div class="text-[11px] text-amber-400 font-bold">Yakuman (13+ Han)</div>
          <div class="text-sm font-black text-white font-mono">32,000 / 48,000</div>
          <div class="text-[10px] text-slate-400">Tsumo: 8000/16000 (16000 all)</div>
        </div>
        <div class="bg-slate-950/80 border border-amber-400/50 p-3 rounded-xl space-y-0.5 bg-gradient-to-br from-amber-950/40 to-slate-950">
          <div class="text-[11px] text-amber-300 font-bold">Double Yakuman</div>
          <div class="text-sm font-black text-amber-200 font-mono">64,000 / 96,000</div>
          <div class="text-[10px] text-amber-400/80">Tsumo: 16000/32000 (32000 all)</div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang="en" />
</Layout>
